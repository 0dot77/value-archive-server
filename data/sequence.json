{
  "sequenceId": "scenario-1-subtitles",
  "steps": [
    { "stepId": "p1-010", "title": "1부 · 명함집 소개", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["지금 당신 앞에는 한 권의", "오래된 명함집이 펼쳐져 있습니다."] } },
    { "stepId": "p1-020", "title": "1부 · 살펴보기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["천천히, 명함집 속 명함을", "한 장 한 장 살펴보세요."] } },
    { "stepId": "p1-030", "title": "1부 · 아버지의 것", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["이 명함집은", "저의 아버지의 것입니다."] } },
    { "stepId": "p1-040", "title": "1부 · 가장", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["그는 엄격하고 헌신적인", "한 한국가정의 가장이었으나,"] } },
    { "stepId": "p1-050", "title": "1부 · 사회인", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["동시에 30년간 전국의 건설현장을", "옮겨가며 치열한 경쟁에서 살아남은", "한 명의 사회인이기도 했습니다."] } },
    { "stepId": "p1-060", "title": "1부 · 한 현장", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["당신 앞에 놓인 명함집 한 권에는,", "그가 약 3년간 한 현장에 머무르는 동안"] } },
    { "stepId": "p1-070", "title": "1부 · 건물", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["광활하고 오래된 동네가 부서지고,", "그 위에 철근과 콘크리트가 쌓여", "하나의 거대한 건물이 지어지기까지"] } },
    { "stepId": "p1-080", "title": "1부 · 축적된 시간", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["그가 만나온 수많은 사람들의", "시간이 축적되어 있습니다."] } },
    { "stepId": "p1-090", "title": "1부 · 당신의 명함", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["당신은 이 자리에 당신의 명함을", "들고 오셨나요?"] } },
    { "stepId": "p1-100", "title": "1부 · 익숙한 얼굴", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["눈 앞에 보이는 수많은 명함들 중에", "익숙한 이름, 익숙한 회사,", "익숙한 누군가의 얼굴이 보이나요?"] } },
    { "stepId": "p1-110", "title": "1부 · 무의식", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["그럴 일은 없겠지만, 이 명함들이", "당신의 무의식 속에 익숙한 이미지로", "다가오는 이유는,"] } },
    { "stepId": "p1-120", "title": "1부 · 규격", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["우리가 일상에서 주고받는 명함이", "대체로 동일한 규격, 비슷한 레이아웃,"] } },
    { "stepId": "p1-130", "title": "1부 · 구성", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["글자 크기와 구성으로", "이루어져 있기 때문일 것입니다."] } },
    { "stepId": "p1-140", "title": "1부 · 저는 명함이 없습니다", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["반면 저는 명함이 없습니다.", "하나의 문장과 단어로 저를", "설명하는 것이 익숙하지 않습니다."] } },
    { "stepId": "p1-150", "title": "1부 · 배운 적 없는", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["생각해보면 누군가에게 명함을", "건네는 법을 배운 적도 없습니다."] } },
    { "stepId": "p1-160", "title": "1부 · 몸은 알고 있다", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["그런데 이상하게도, 우리의 몸은", "본능적으로 명함을 건네는 법을", "알고 있습니다."] } },
    { "stepId": "p1-170", "title": "1부 · 두 손으로", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["두 손으로. 상대의 방향으로.", "눈을 맞추며."] } },
    { "stepId": "p1-180", "title": "1부 · 물려받은 움직임", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["배운 적 없는 움직임을", "어디에서 물려받았을까요."] } },
    { "stepId": "p1-190", "title": "1부 · 상상", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["저와 함께 한 가지 상상을 해보죠.", "제가 한 번도 본 적 없는,"] } },
    { "stepId": "p1-200", "title": "1부 · 그 장면", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["아버지가 누군가와 마주 서서", "명함을 주고받는 그 장면을요."] } },
    { "stepId": "p1-210", "title": "1부 · 준비물", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["이 원본 없는 상상과 추측의 재현에는,", "하나의 준비물이 필요합니다."] } },
    { "stepId": "p1-220", "title": "1부 · 수상한 명함", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["명함집 속에서 수상한 명함 한 장을", "찾아보세요."] } },
    { "stepId": "p1-230", "title": "1부 · 한 손에 쥐기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["그리고 그 명함을 꺼내,", "눈앞에 한 손으로 쥐어보세요."] } },
    { "stepId": "p2-010", "title": "2부 · 목소리 전환", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "안내", "lines": ["— 목소리가 바뀝니다 —"] } },
    { "stepId": "p2-020", "title": "2부 · 명함의 규격", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["당신의 눈앞에 들려 있는 이 명함은", "가로 9센티미터, 세로 5센티미터,", "250그램짜리 두껍고 탄력 있는 종이로"] } },
    { "stepId": "p2-030", "title": "2부 · 묵직함", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["얇지만, 묵직합니다."] } },
    { "stepId": "p2-040", "title": "2부 · 무해한 무기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["이 종이는 나를 대표하는 정보가 담긴,", "세상에서 가장 가볍고 무해한", "무기일 것입니다."] } },
    { "stepId": "p2-050", "title": "2부 · 주고받기 예고", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["당신은 지금부터 한 손으로 명함을 쥐고,", "건너편에 있는 상대와 이 명함을", "주고받을 것입니다."] } },
    { "stepId": "p2-060", "title": "2부 · 일상의 장면", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["이 움직임의 여정이 누군가에게는", "일상에서 수없이 마주하는 장면일 수도", "있겠지만,"] } },
    { "stepId": "p2-070", "title": "2부 · 첫인상", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["단 한 번의 짧은 행위로 서로의", "첫인상을 각인시키는 중요한", "순간이기도 합니다."] } },
    { "stepId": "p2-080", "title": "2부 · 상대 발견", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["고개를 들면, 멀리 명함을 든", "또 한 사람이 보입니다."] } },
    { "stepId": "p2-090", "title": "2부 · 걷기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["그 사람을 향해, 한 발자국씩", "천천히 걸어가세요."] } },
    { "stepId": "p2-100", "title": "2부 · 몸 스코어", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["등을 펴고. 어깨는 내리고.", "턱은 살짝 당깁니다."] } },
    { "stepId": "p2-110", "title": "2부 · 당당하게", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["떳떳하고 당당하게. 그러나", "거만해 보이지 않게 말이죠."] } },
    { "stepId": "p2-120", "title": "2부 · 긴장", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["걸음마다 미세한 긴장이 스며들어도", "괜찮습니다. 그 긴장 또한,", "물려받은 것이니까요."] } },
    { "stepId": "p2-130", "title": "2부 · 응시", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["상대와 마주 보고, 잠시 서서", "상대의 얼굴을 응시합니다."] } },
    { "stepId": "p2-140", "title": "2부 · 가벼운 접촉", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["이제 우리는 아주 가벼운 접촉을", "수행할 것입니다."] } },
    { "stepId": "p2-150", "title": "2부 · 악수의 기원", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["악수는 중세의 기사들이 서로의 손에", "무기가 없음을 증명하는", "평화의 움직임입니다."] } },
    { "stepId": "p2-160", "title": "2부 · 다시 마주 서기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["빈손을 보여주는 것으로 시작된 이 인사는,", "오늘날 서로의 손에 종이 한 장을 쥐고", "다시 마주 섭니다."] } },
    { "stepId": "p2-170", "title": "2부 · 빈손", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["세상에서 가장 가벼운 무기를 잠시 감추고,", "아무것도 없는 당신의 손을 보여주세요."] } },
    { "stepId": "p2-180", "title": "2부 · 맞잡기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["그리고 천천히, 맞잡아봅니다.", "확신 있게 상대의 손을 쥐어보세요."] } },
    { "stepId": "p2-190", "title": "2부 · 흔들기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["그리고 아주 가볍게.", "빠르지도 느리지도 않게.", "위아래로 흔들어봅니다."] } },
    { "stepId": "p2-200", "title": "2부 · 무기의 존재", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["이제 아주 천천히, 당신이 가진", "무해한 무기의 존재를 상대가", "인식하게 합니다."] } },
    { "stepId": "p2-210", "title": "2부 · 보여주기", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["천천히, 다른 손에 당신의 명함이", "있음을 보여주는 거예요."] } },
    { "stepId": "p2-220", "title": "2부 · 나란히 · 정지", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "아버지", "lines": ["이제 이 명함을, 상대의 명함과 나란히", "한 열에 평행하게 배치해보세요.", "그리고 잠시 멈춰주세요."] } },
    { "stepId": "p3-010", "title": "3부 · 노래 트리거 대기", "targets": ["A", "B"],
      "trigger": { "type": "condition", "metric": "markerToMarker", "op": "<", "valueMeters": 0.3, "holdMs": 500, "source": "both" },
      "params": { "speaker": "안내", "lines": ["두 명함이 나란히 인식되면", "노래가 시작됩니다."] } },
    { "stepId": "p3-020", "title": "3부 · 상상의 멈춤", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["서로의 명함이 나란히, 두 사람 가운데에", "놓인 이 장면에서, 제 상상은 멈춥니다."] } },
    { "stepId": "p3-030", "title": "3부 · 그 이상", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["이상하게도 저는, 아버지가 명함을", "건네는 장면 그 이상을 상상하기", "어렵습니다."] } },
    { "stepId": "p3-040", "title": "3부 · 어떤 표정", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["상대의 명함을 눈앞에 둔 아버지는,", "어떤 표정을 하고 있을까요."] } },
    { "stepId": "p3-050", "title": "3부 · 어떤 몸짓", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["어떤 몸짓으로, 상대의 명함을", "건네받았을까요."] } },
    { "stepId": "p3-060", "title": "3부 · 낭송 예절", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["상대의 명함을 확인하면, 이름과 직급을", "서로 나지막하게 읊조려보는 것이", "예의라고 합니다."] } },
    { "stepId": "p3-070", "title": "3부 · 짧은 낭송", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["한 문장씩 주고받는,", "짧은 낭송처럼 느껴지지 않나요."] } },
    { "stepId": "p3-080", "title": "3부 · 자유", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "딸", "lines": ["반주가 흐르는 동안, 언제든 서로의", "명함을 교환하고 헤어져도 좋습니다."] } },
    { "stepId": "p4-010", "title": "4부 · 헤어짐", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": { "speaker": "안내", "lines": ["받은 명함을 품에 넣어도 좋고,", "명함집의 빈칸에 꽂아도 좋습니다."] } },
    { "stepId": "p4-020", "title": "4부 · 종료 (자막 끔)", "targets": ["A", "B"], "trigger": { "type": "manual" },
      "params": {} }
  ]
}
